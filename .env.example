# 复制为 .env 并填入真实值。.env 已被 .gitignore 排除，不会入库。
# 此文件仅为格式示例，请勿在此填入真实密钥。

# ---- AWS（部署与云端运行必需）----
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=us-west-2

# ---- 可选：HTTP(S) 代理（网络受限环境）----
# deploy.sh / renew-acm.sh 会 source 这个文件（不存在则跳过）
# PROXY_SCRIPT=/home/you/proxy.sh

# ---- 可选：OCR（拍照识别词表）----
# 未配置时，拍照识别不可用，但「粘贴文本」录入不受影响。
# 申请地址：https://open.bigmodel.cn/
# ZHIPU_API_KEY=YOUR_ZHIPU_API_KEY

# ---- 本地开发（不连 SSM 时）----
# 任意足够随机的字符串即可；用它签发本地登录令牌。
# OPERON_DEV_JWT_SEED=change-me-to-a-long-random-string
# OPERON_DEV_ZHIPU_API_KEY=YOUR_ZHIPU_API_KEY

# ---- 本地开发：指向已有 AWS 资源 ----
# OPERON_MOXIE_AUDIO_BUCKET=moxie-dev-audio
# OPERON_TABLE_PREFIX=moxie-dev-